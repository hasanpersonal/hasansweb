<div style="width: 100%; max-width: 900px; margin: 0 auto; font-family: sans-serif; padding-bottom: 30px;">
    <h2 style="text-align: center; color: #333; margin: 20px 0; font-size: 1.5rem;">YouTube Videos</h2>

    <% if (typeof videos !== 'undefined' && videos.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 30px;">
            <% videos.forEach(function(video) { %>
                <div style="background: #ffffff; border-radius: 0; md-border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.15); overflow: hidden;">
                    
                    <!-- Title on Top -->
                    <div style="padding: 15px 15px 10px 15px;">
                        <h3 style="margin: 0; color: #1f2937; font-size: 1.25rem; font-weight: bold; line-height: 1.4;"><%= video.title %></h3>
                    </div>

                    <!-- Full Width Responsive Video Player -->
                    <div style="position: relative; padding-bottom: 56.25%; height: 0; width: 100%; background: #000;">
                        <iframe 
                            src="<%= video.embedUrl %>?modestbranding=1&rel=0" 
                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen>
                        </iframe>
                    </div>

                    <!-- Description at Bottom -->
                    <% if(video.description) { %>
                        <div style="padding: 12px 15px; background: #f9fafb; border-top: 1px solid #f3f4f6;">
                            <p style="margin: 0; color: #4b5563; font-size: 0.95rem; line-height: 1.5;"><%= video.description %></p>
                        </div>
                    <% } %>

                </div>
            <% }); %>
        </div>
    <% } else { %>
        <p style="text-align: center; color: #666; padding: 20px;">No videos uploaded yet.</p>
    <% } %>
</div>
